---
import { NAV_ITEMS } from "../data/nav";
import { withBase } from "../lib/url";

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const currentPath = rawPath.startsWith(base) ? "/" + rawPath.slice(base.length) : rawPath;
---

<nav class="nav">
  <div class="nav-inner container">
    <span class="nav-brand">RB_/portfolio</span>
    <ul class="nav-links">
      {
        NAV_ITEMS.map((item) =>
          item.href ? (
            <li>
              <a
                href={withBase(item.href)}
                class={
                  item.href === "/"
                    ? currentPath === "/"
                      ? "active"
                      : ""
                    : currentPath.startsWith(item.href)
                      ? "active"
                      : ""
                }
              >
                {item.label}
              </a>
            </li>
          ) : (
            <li>
              <span class="disabled" title="Page à venir">
                {item.label}
              </span>
            </li>
          )
        )
      }
    </ul>
  </div>
</nav>
